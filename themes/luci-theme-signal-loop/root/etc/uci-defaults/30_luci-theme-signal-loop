#!/bin/sh

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.SignalLoop /luci-static/signal-loop

# Make Signal Loop the default theme on fresh installs only. Existing
# installations keep whatever theme the user has selected.
if [ "$PKG_UPGRADE" != 1 ] && [ "$changed" = 1 ]; then
	set_opt main.mediaurlbase /luci-static/signal-loop
fi

if [ "$changed" = 1 ]; then
	uci commit luci
fi

exit 0
